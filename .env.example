# ══════════════════════════════════════════════════════════════════════════════
# Financial Document AI Platform — Environment Configuration
# Copy this file to .env and modify as needed:
#   cp .env.example .env
# ══════════════════════════════════════════════════════════════════════════════

# Set to true for verbose logging
DEBUG=false

# OCR — set to true if you have CUDA GPU
OCR_USE_GPU=false

# LLM Fallback — set to false if Ollama is not installed
USE_LLM_FALLBACK=false

# Ollama model — change to llama2, codellama, etc. if preferred
OLLAMA_MODEL=mistral

# Ollama URL — change if running on different port
OLLAMA_BASE_URL=http://localhost:11434

# Minimum fields from regex before triggering LLM fallback (1-10)
MIN_FIELDS_BEFORE_LLM=4

# Maximum files in a single batch upload
MAX_BATCH_SIZE=20

# ── Fine-tuned Model (LoRA) ──────────────────────────────────────────────
# Set to true AFTER running: python finetuning/finetune_lora.py
USE_FINETUNED_MODEL=false

# Path to saved LoRA adapter weights
FINETUNED_MODEL_PATH=finetuning/models/invoice-lora

# Base model used during fine-tuning
FINETUNED_BASE_MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0
